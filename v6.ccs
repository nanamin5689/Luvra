/* OpenVideo v6 */
#top{background:#fff;border-bottom:1px solid #e3e6ee;color:#0a1f6b;display:block}
#top[hidden]{display:none}
.bar{display:flex;align-items:center;gap:10px;padding:8px 12px;min-height:54px}
.brand{font-weight:900;font-size:1.35rem;letter-spacing:-.4px;color:#0a2a9c;flex:0 0 auto;line-height:1}
.bsearch{flex:1;min-width:0;display:flex;align-items:center;gap:6px;background:#eef1f7;border-radius:99px;padding:0 12px;height:38px}
.bsearch svg{width:18px;height:18px;color:#6b7694;flex:0 0 auto}
.bsearch input{flex:1;min-width:0;background:transparent;border:0;outline:0;color:#0a1f6b;font-size:.92rem;height:100%}
.bsearch input::placeholder{color:#7b86a3}
.bmenu{background:#0a2a9c;color:#fff;font-weight:700;border-radius:99px;padding:8px 16px;font-size:.9rem;margin-left:auto}
.bar.noS .bsearch{display:none}
.bar.noS .brand{flex:1}
/* Facebook-style feed */
.fbfeed{background:#0b0d12;padding:8px 0 24px}
.fbp{background:var(--sf);margin:0 0 10px;border-top:1px solid var(--bd);border-bottom:1px solid var(--bd)}
.fbh{display:flex;align-items:center;gap:10px;padding:10px 12px}
.fbh .nm{flex:1;min-width:0;text-align:left}
.fbh .nm b{display:block;font-size:.95rem;line-height:1.2}
.fbh .nm small{color:var(--mu);font-size:.74rem}
.fbh .av{cursor:pointer}
.fbfol{color:var(--ac);font-weight:700;font-size:.85rem;padding:6px 8px}
.fbfol.on{color:var(--mu)}
.fbcap{padding:0 12px 10px;line-height:1.55;font-size:.95rem;white-space:pre-wrap;word-break:break-word;text-align:left}
.fbm{position:relative;background:#000;max-height:78vh;display:flex;justify-content:center;overflow:hidden}
.fbm img,.fbm video{width:100%;max-height:78vh;object-fit:contain;display:block}
.fbm .mute{position:absolute;left:10px;bottom:10px;background:rgba(0,0,0,.6);color:#fff;border-radius:99px;font-size:.75rem;padding:5px 10px}
.fbc{display:flex;justify-content:space-between;padding:8px 12px;color:var(--mu);font-size:.8rem}
.fba{display:flex;border-top:1px solid var(--bd);position:relative}
.fba button{flex:1;padding:11px 2px;font-size:.88rem;color:var(--mu);font-weight:600;display:flex;align-items:center;justify-content:center;gap:6px}
.fba button.on{color:var(--ac2)}
.fba .tray{position:absolute;left:6px;bottom:48px;display:flex;gap:4px;background:var(--sf2);border:1px solid var(--bd);border-radius:99px;padding:6px 8px;z-index:3}
.fba .tray button{flex:0 0 auto;font-size:1.4rem;padding:2px 4px;flex-direction:column;gap:0}
.fba .tray small{font-size:.6rem;color:var(--mu)}
.fbmore{text-align:center;color:var(--mu);padding:18px;font-size:.85rem}
/* auth screen */
.authw{padding:18px 16px 30px;max-width:440px;margin:0 auto;width:100%}
.authw h1{font-size:1.5rem;margin:6px 0 4px;color:var(--tx)}
.authw p.sub{color:var(--mu);font-size:.88rem;line-height:1.6;margin:0 0 16px}
.seg{display:flex;background:var(--sf);border-radius:12px;padding:4px;margin:0 0 16px}
.seg button{flex:1;padding:10px;border-radius:9px;font-weight:700;color:var(--mu)}
.seg button.on{background:var(--ac);color:#fff}
.sbt{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;padding:12px;border-radius:12px;background:#fff;color:#111;font-weight:700;margin-bottom:10px;border:1px solid #ddd}
.sbt.fb{background:#1877f2;color:#fff;border-color:#1877f2}
.sbt.tt{background:#111;color:#fff;border-color:#333}
.sbt.off{opacity:.55}
.or{display:flex;align-items:center;gap:10px;color:var(--mu);font-size:.8rem;margin:14px 0}
.or:before,.or:after{content:"";flex:1;height:1px;background:var(--bd)}
.authw input{width:100%;margin-bottom:10px}
.authw .err{color:#f87171;font-size:.85rem;line-height:1.5;margin:6px 0}
.authw .ok{color:var(--ok);font-size:.85rem;line-height:1.5;margin:6px 0}
.linkbtn{color:var(--ac);font-size:.85rem;padding:6px 0;text-align:left}
/* drawer */
.dback{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:40}
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(320px,86vw);background:var(--bg);border-left:1px solid var(--bd);z-index:41;display:flex;flex-direction:column;padding-top:env(safe-area-inset-top);animation:dsl .2s ease-out}
@keyframes dsl{from{transform:translateX(100%)}to{transform:none}}
.drawer .dh{display:flex;align-items:center;gap:10px;padding:16px;border-bottom:1px solid var(--bd)}
.drawer .dh b{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.drawer .mi{display:flex;align-items:center;gap:12px;width:100%;text-align:left;padding:15px 18px;border-bottom:1px solid var(--bd);font-size:.98rem}
.drawer .mi span:first-child{width:26px;text-align:center}
.drawer .mi.red{color:#f87171}
/* profile bits */
.stats.pub div{cursor:default}
.chatbar{display:flex;gap:8px;padding:0 14px 12px}
.chatbar input{flex:1;border-radius:99px;padding:10px 14px}
.chatbar .btn{border-radius:99px}
.pact{display:flex;gap:8px;padding:0 14px 10px}
.pact .btn{flex:1}
/* chat */
.arow{display:flex;gap:12px;overflow-x:auto;padding:10px 12px;scrollbar-width:none}
.arow::-webkit-scrollbar{display:none}
.ac{flex:0 0 auto;width:64px;text-align:center;font-size:.72rem;color:var(--mu);position:relative}
.ac .av{margin:0 auto 4px}
.ac .dot,.dot{position:absolute;width:12px;height:12px;border-radius:50%;background:#22c55e;border:2px solid var(--bg);right:8px;top:36px}
.ac span{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.urow{display:flex;gap:12px;align-items:center;width:100%;padding:10px 12px;text-align:left}
.urow .nm{flex:1;min-width:0}
.urow .nm b{display:block}
.urow .nm small{color:var(--mu);font-size:.76rem}
.pill{padding:6px 12px;border-radius:99px;background:var(--ac);color:#fff;font-size:.8rem;font-weight:700}
.pill.alt{background:var(--sf2);color:var(--mu)}
.avw{position:relative}
/* wide overlay (owner center) */
.ov.wide{max-width:1100px}
.oc{padding:12px;overflow:auto;flex:1}
.ocg{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-bottom:12px}
.ocg .card{margin:0;text-align:center;padding:12px 8px}
.ocg .card b{display:block;font-size:1.35rem}
.ocg .card small{color:var(--mu);font-size:.74rem}
.octabs{display:flex;gap:6px;margin:0 0 12px;overflow-x:auto}
.octabs button{padding:8px 14px;border-radius:99px;background:var(--sf);color:var(--mu);font-weight:700;white-space:nowrap}
.octabs button.on{background:var(--ac);color:#fff}
.swr{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--bd)}
.swr:last-child{border-bottom:0}
.swr .txw{flex:1}
.swr .txw b{display:block}
.swr .txw small{color:var(--mu);font-size:.78rem;line-height:1.5}
.tg{width:50px;height:28px;border-radius:99px;background:#3a4256;position:relative;flex:0 0 auto;transition:.2s}
.tg:after{content:"";position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;background:#fff;transition:.2s}
.tg.on{background:var(--ok)}
.tg.on:after{left:25px}
.utab{width:100%;border-collapse:collapse;font-size:.85rem}
.utab th{color:var(--mu);text-align:left;padding:6px;font-weight:600;border-bottom:1px solid var(--bd)}
.utab td{padding:8px 6px;border-bottom:1px solid var(--bd);vertical-align:middle}
.ucard{display:none}
.btn.sm{padding:6px 10px;font-size:.78rem;border-radius:9px}
.btn.red{background:#b91c1c}
@media (max-width:720px){
  .utab{display:none}
  .ucard{display:block;background:var(--sf);border:1px solid var(--bd);border-radius:14px;padding:12px;margin-bottom:10px}
  .ucard .r{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
}
.qr{background:#fff;padding:10px;border-radius:12px;display:inline-block}
.qr img{width:180px;height:180px;display:block}
.sec2{font-family:ui-monospace,monospace;word-break:break-all;background:var(--sf);padding:8px 10px;border-radius:8px;font-size:.8rem;margin:8px 0}
.sres h4{margin:14px 12px 6px;color:var(--mu);font-size:.82rem}
